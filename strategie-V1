 DIMS.forEach(([k,dim],ci)=>{const cx=96+ci*(colW+36),sc=k=="x"?R.X:k=="y"?R.Y:R.C;
  x.fillStyle="#0095D0";rr(x,cx,top,colW,52,10);x.fill();
  x.fillStyle="#fff";x.font="bold 18px Arial";x.fillText(dim,cx+16,top+33);
  x.textAlign="right";x.font="bold 22px Arial";x.fillText(sign(sc),cx+colW-16,top+34);x.textAlign="left";
  rows.filter(r=>r.k==k).forEach((r,j)=>{const ry=top+70+j*rowH;
   if(j)x.fillStyle="#EAF5FA",x.fillRect(cx,ry-10,colW,1.5);
   const pill=r.mv?(r.mv>0?"+1":"−1"):"0";
   x.fillStyle=r.mv?"#0095D0":"#E8ECEF";rr(x,cx,ry,44,28,14);x.fill();
   x.fillStyle=r.mv?"#fff":"#666";x.font="bold 16px Arial";x.textAlign="center";x.fillText(pill,cx+22,ry+20);x.textAlign="left";
   const head=r.num+". "+r.theme+(r.mv?"  ·  "+r.rep:"");let fz=16;x.fillStyle="#111";
   do{x.font="bold "+fz+"px Arial";fz--}while(x.measureText(head).width>colW-56&&fz>11);
   x.fillText(head,cx+56,ry+19);
   x.font=(r.mv?"":"italic ")+"15px Calibri, Carlito, Arial";x.fillStyle="#555";
   const t=nb(r.mv?r.phrase:r.rep);lines(t,colW-56,3).forEach((l,n)=>x.fillText(l,cx+56,ry+41+n*18))})});
 x.fillStyle="#888";x.font="13px Arial";x.fillText("Code réponses : "+answerCode(),96,top+70+8*rowH+6);
 // pied de page
 const fy=H-80,lg=await loadImg(LOGO);x.drawImage(lg,54,fy,lg.width*46/lg.height,46);
 x.fillStyle="#333";x.font="bold 13px Arial";x.textAlign="center";
 x.fillText("@HIIATO – Toute copie (Totale ou partielle) interdite – Utilisation commerciale interdite si",W/2,fy+22);
 x.fillText("non expressément acceptée dans le cadre d'une convention spécifique rédigée par HIIATO",W/2,fy+40);
 return c}
// ---------- PDF (écrit à la main : une page, image JPEG, aucune bibliothèque externe) ----------
function pdfStr(t){let h="FEFF";for(const ch of t){const c=ch.codePointAt(0);if(c>0xFFFF){const v=c-0x10000;h+=(0xD800+(v>>10)).toString(16).padStart(4,"0")+(0xDC00+(v&0x3FF)).toString(16).padStart(4,"0")}else h+=c.toString(16).padStart(4,"0")}return "<"+h.toUpperCase()+">"}
async function buildPDF(){
 const c=await buildCanvas(1.5);
 const jpg=new Uint8Array(await (await new Promise(ok=>c.toBlob(ok,"image/jpeg",.9))).arrayBuffer());
 const pw=595.28,ph=+(pw*c.height/c.width).toFixed(2);
 const enc=new TextEncoder(),parts=[],offs=[];let len=0;
 const push=u=>{parts.push(u);len+=u.length};const put=t=>push(enc.encode(t));
 const obj=(n,body)=>{offs[n]=len;put(n+" 0 obj\n"+body+"\nendobj\n")};
 put("%PDF-1.4\n%\u00e2\u00e3\n");
 obj(1,"<< /Type /Catalog /Pages 2 0 R >>");
 obj(2,"<< /Type /Pages /Kids [3 0 R] /Count 1 >>");
 obj(3,"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 "+pw+" "+ph+"] /Resources << /XObject << /Im0 4 0 R >> >> /Contents 5 0 R >>");
 offs[4]=len;put("4 0 obj\n<< /Type /XObject /Subtype /Image /Width "+c.width+" /Height "+c.height+" /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length "+jpg.length+" >>\nstream\n");push(jpg);put("\nendstream\nendobj\n");
 const cs="q "+pw+" 0 0 "+ph+" 0 0 cm /Im0 Do Q";obj(5,"<< /Length "+cs.length+" >>\nstream\n"+cs+"\nendstream");
 const who=[S.prenom,S.entreprise].filter(Boolean).join(" – ");
 obj(6,"<< /Title "+pdfStr("Ma stratégie d'entreprise"+(who?" – "+who:""))+" /Author "+pdfStr(S.prenom||"Stagiaire")+" /Subject "+pdfStr(S.entreprise||"")+" /Keywords "+pdfStr(answerCode())+" /Creator (Hiato) >>");
 const xref=len;let t="xref\n0 7\n0000000000 65535 f \n";for(let n=1;n<=6;n++)t+=String(offs[n]).padStart(10,"0")+" 00000 n \n";
 put(t+"trailer\n<< /Size 7 /Root 1 0 R /Info 6 0 R >>\nstartxref\n"+xref+"\n%%EOF\n");
 return new Blob(parts,{type:"application/pdf"})}
const pdfName=()=>"strategie-"+slug()+".pdf";
const stateKey=()=>JSON.stringify(S);
let PDF={key:null,file:null,busy:null},pdfT;
function makePDF(){const k=stateKey();if(PDF.key===k&&PDF.file)return Promise.resolve(PDF.file);
 if(PDF.busy&&PDF.busy.k===k)return PDF.busy.p;
 const p=buildPDF().then(b=>{const f=new File([b],pdfName(),{type:"application/pdf"});if(stateKey()===k){PDF.key=k;PDF.file=f}return f});
 PDF.busy={k,p};return p}
function schedulePDF(){clearTimeout(pdfT);if(compute().done>0)pdfT=setTimeout(()=>makePDF().catch(()=>{}),700)}
const msg=document.getElementById("msg");
document.getElementById("exp").onclick=async()=>{
 msg.textContent="Préparation du PDF…";
 try{const f=await makePDF();await saveFile(pdfName(),f,"PDF enregistré.")}catch(e){msg.textContent="L'export a échoué."}};
const SUBJECT=()=>"Formation – Ma stratégie d'entreprise"+(S.entreprise?" ("+S.entreprise+")":"");
function shareData(f){return{files:[f],title:SUBJECT(),text:"À envoyer à contact@hiiato.fr – "+SUBJECT()}}
function canShareFile(f){try{return !!(navigator.canShare&&navigator.share&&navigator.canShare({files:[f]}))}catch(e){return false}}
async function fallbackSend(f){
 await saveFile(f.name,f,"PDF enregistré.");
 msg.textContent="PDF enregistré. Joignez-le au mail qui s'ouvre (fichier "+f.name+").";
 location.href="mailto:contact@hiiato.fr?subject="+encodeURIComponent(SUBJECT())+"&body="+encodeURIComponent("Bonjour,\n\nVous trouverez en pièce jointe mon schéma et mes réponses (fichier "+f.name+").\n\n");}
function doShare(f){
 navigator.share(shareData(f)).then(()=>{msg.textContent="PDF partagé."}).catch(e=>{
  if(e&&e.name==="AbortError")msg.textContent="Envoi annulé.";
  else if(e&&e.name==="NotAllowedError")msg.textContent="PDF prêt : appuyez à nouveau sur « Envoyer ».";
  else fallbackSend(f)})}
document.getElementById("send").onclick=async()=>{
 if(compute().done===0){msg.textContent="Répondez d'abord aux questions.";return}
 // PDF déjà prêt : le partage part immédiatement, dans le geste de l'utilisateur (exigé par les téléphones)
 if(PDF.key===stateKey()&&PDF.file){const f=PDF.file;if(canShareFile(f))doShare(f);else fallbackSend(f);return}
 msg.textContent="Préparation du PDF…";
 try{const f=await makePDF();if(canShareFile(f))doShare(f);else await fallbackSend(f)}catch(e){msg.textContent="La préparation du PDF a échoué."}};
document.getElementById("csv").onclick=async()=>{
 try{await saveFile("reponses-"+slug()+"-"+VERSION+".csv",new Blob([buildCSV()],{type:"text/csv"}),"Fichier de réponses enregistré.")}
 catch(e){msg.textContent="L'enregistrement a échoué."}};
let rt;window.addEventListener("resize",()=>{clearTimeout(rt);rt=setTimeout(refresh,150)});
refresh();
</script>

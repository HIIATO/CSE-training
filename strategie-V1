const score=a=>a.reduce((s,v)=>s+(v=="m"?-1:v=="p"?1:0),0);
const cnt=(a,v)=>a.filter(x=>x==v).length;
/* Mixité d'un axe : « Les deux » + nombre de paires où l'autre pôle est aussi choisi.
   4 réponses « coûts » et 4 « différenciation » donnent un score de 0 mais décrivent une combinaison, pas une absence de stratégie. */
const mix=a=>cnt(a,"h")+Math.min(cnt(a,"m"),cnt(a,"p"));
function compute(){
 const X=score(S.x),Y=score(S.y),C=score(S.c),Hx=mix(S.x),Hy=mix(S.y);
 const done=[...S.x,...S.y,...S.c].filter(v=>v!=null).length;
 const xp=X<-MID?"c":X>MID?"d":(Hx>=HMIN?"h":"f");
 const yp=Y>MID?"hi":Y<-MID?"lo":"mid";
 let key=xp+"_"+yp; if(!TITRES[key])key=xp+"_lo";
 return{X,Y,C,Hx,Hy,done,key,yp,fragile:cnt(S.x,"?")>=3||cnt(S.y,"?")>=3||cnt(S.c,"?")>=3}}
const coopLvl=C=>C>MID?3:C<-MID?1:2;
function texts(R){const T=TITRES[R.key],l=coopLvl(R.C);
 let desc=T[1],emp=T[2];
 if(R.yp=="mid"&&R.Hy>=HMIN){desc+=" Elle mène de front l'amélioration de l'existant et les nouveautés.";emp+=" Les équipes doivent produire et changer en même temps : vigilance sur la charge de travail."}
 desc+=l==3?" Elle s'appuie fortement sur d'autres structures.":l==2?" Elle n'est ni clairement autonome, ni clairement liée à d'autres structures.":" Elle agit essentiellement seule.";
 if(l==3)emp+=" La mutualisation avec d'autres entités peut créer des doublons de postes et des transferts.";
 if(S.c[IDX_DECISIONS]=="p")emp+=" Les décisions importantes se prennent hors de l'entreprise : le CSE doit savoir où.";
 return{titre:T[0],desc:nb(desc),emploi:nb(emp)}}
function nspItems(){const a=[];["x","y","c"].forEach(k=>S[k].forEach((v,i)=>v=="?"&&a.push(AX[k].items[i][3])));return a.map(nb)}

function mark(cx,cy,C,fragile,r){
 const l=coopLvl(C),ring=fragile?`<circle cx="${cx}" cy="${cy}" r="${r+5}" fill="none" stroke="#0095D0" stroke-width="2" stroke-dasharray="4 3"/>`:'';
 if(l==3)return ring+`<circle cx="${cx}" cy="${cy}" r="${r}" fill="#0095D0" stroke="#0095D0" stroke-width="3"/>`;
 const base=`<circle cx="${cx}" cy="${cy}" r="${r}" fill="#fff" stroke="#0095D0" stroke-width="3"/>`;
 return ring+(l==2?base+`<path d="M${cx} ${cy-r}a${r} ${r} 0 0 0 0 ${2*r}z" fill="#0095D0"/>`:base)}

function matrixSVG(R,W,H,fs){
 const L=fs*3.4,T=6,PW=W-L-fs*1.3,PH=H-T-fs*3.6;
 const xs=v=>L+(v+N)/(2*N)*PW, ys=v=>T+PH/2-(v/N)*(PH/2);
 const mx=xs(0),my=ys(0),bx1=xs(-MID-.5),bx2=xs(MID+.5),by1=ys(MID+.5),by2=ys(-MID-.5);
 const F="font-family:Arial,Helvetica,sans-serif";
 let s=`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}">`;
 s+=`<rect x="${L}" y="${T}" width="${PW}" height="${PH}" fill="#fff" stroke="#D6EEF8" stroke-width="1.5"/>`;
 s+=`<rect x="${L}" y="${T}" width="${mx-L}" height="${my-T}" fill="#EAF7FD"/>`;
 s+=`<rect x="${mx}" y="${T}" width="${L+PW-mx}" height="${my-T}" fill="#D5F2FC"/>`;
 s+=`<rect x="${mx}" y="${my}" width="${L+PW-mx}" height="${T+PH-my}" fill="#F3FBFE"/>`;
 s+=`<rect x="${bx1}" y="${T}" width="${bx2-bx1}" height="${PH}" fill="#fff" opacity=".55"/><rect x="${L}" y="${by1}" width="${PW}" height="${by2-by1}" fill="#fff" opacity=".55"/>`;
 const dl=(a,b,c,d)=>`<line x1="${a}" y1="${b}" x2="${c}" y2="${d}" stroke="#9ADDF3" stroke-dasharray="3 4"/>`;
 s+=dl(bx1,T,bx1,T+PH)+dl(bx2,T,bx2,T+PH)+dl(L,by1,L+PW,by1)+dl(L,by2,L+PW,by2);
 s+=`<line x1="${mx}" y1="${T}" x2="${mx}" y2="${T+PH}" stroke="#0095D0" stroke-width="1.5"/><line x1="${L}" y1="${my}" x2="${L+PW}" y2="${my}" stroke="#0095D0" stroke-width="1.5"/>`;
 s+=`<circle cx="${mx}" cy="${my}" r="${fs*.28}" fill="#0095D0"/>`;
 const lab=(x,y,a,l1,l2,up)=>{const dy=fs*1.2,y1=up?y:y-dy;return `<text text-anchor="${a}" style="${F};font-size:${fs}px;font-weight:700" fill="#0095D0"><tspan x="${x}" y="${y1}">${l1}</tspan><tspan x="${x}" y="${y1+dy}">${l2}</tspan></text>`};
 const p=fs*.8;
 s+=lab(L+p,T+p+fs,"start","Productivité","technologique",1)+lab(L+PW-p,T+p+fs,"end","Leader","innovant",1)+lab(L+p,T+PH-p,"start","Prix bas,","modèle établi",0)+lab(L+PW-p,T+PH-p,"end","Qualité, marque,","savoir-faire",0);
 for(let v=-N;v<=N;v+=4){s+=`<text x="${xs(v)}" y="${T+PH+fs*1.35}" text-anchor="middle" style="${F};font-size:${fs*.85}px" fill="#666">${v>0?"+"+v:v}</text>`;
  s+=`<text x="${L-fs*.6}" y="${ys(v)+fs*.3}" text-anchor="end" style="${F};font-size:${fs*.85}px" fill="#666">${v>0?"+"+v:v}</text>`}
 const ax=`style="${F};font-size:${fs*1.02}px;font-weight:700" fill="#000"`;
 s+=`<text x="${L}" y="${H-fs*.4}" ${ax}>◄ Coûts</text><text x="${L+PW}" y="${H-fs*.4}" text-anchor="end" ${ax}>Différenciation ►</text>`;
 s+=`<text transform="translate(${fs*1.05},${T+PH}) rotate(-90)" ${ax}>◄ Exploitation</text><text transform="translate(${fs*1.05},${T}) rotate(-90)" text-anchor="end" ${ax}>Exploration ►</text>`;
 if(R.done>0){const cx=xs(R.X),cy=ys(R.Y),r=fs*1.05;
  s+=mark(cx,cy,R.C,R.fragile,r);
  const name=esc((S.entreprise||"Mon entreprise").slice(0,28)),right=cx<L+PW*.55;
  s+=`<text x="${cx+(right?1:-1)*(r+fs*.5)}" y="${cy+fs*.38}" text-anchor="${right?"start":"end"}" style="${F};font-size:${fs*1.1}px;font-weight:700" fill="#000" stroke="#fff" stroke-width="4" paint-order="stroke">${name}</text>`}
 return s+"</svg>"}


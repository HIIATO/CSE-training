<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ma stratégie d'entreprise en un schéma</title>
<style>
:root{--cyan:#25CCF6;--bleu:#0095D0;--bleu-f:#007DB0;--noir:#0B0B0B;--gris:#666;--bord:#D6EEF8;--fond:#F3FAFD;--r:12px}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{-webkit-text-size-adjust:100%}
body{margin:0;font-family:Calibri,Carlito,"Segoe UI",Roboto,Arial,sans-serif;color:#1d1d1d;background:#fff;line-height:1.4}
.t{font-family:Arial,Helvetica,sans-serif}
.wrap{max-width:980px;margin:0 auto;padding:0 24px 40px}

/* bandeau */
.hero{background:linear-gradient(135deg,#25CCF6 0%,#0095D0 70%);color:#fff;padding:44px 24px 84px}
.hero .in{max-width:980px;margin:0 auto;padding:0 24px}
.hero .kick{font-family:Arial,sans-serif;font-size:13px;letter-spacing:.12em;text-transform:uppercase;opacity:.85;margin:0 0 12px}
.hero h1{font-family:Arial,sans-serif;font-size:38px;line-height:1.12;margin:0 0 12px;font-weight:700}
.hero p{margin:0;font-size:19px;opacity:.95;max-width:620px}
.lift{margin-top:-52px}

/* progression */
.progress{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.96);backdrop-filter:blur(6px);border-bottom:1px solid var(--bord)}
.progress .in{max-width:980px;margin:0 auto;padding:10px 24px;display:flex;align-items:center;gap:14px}
.progress .bar{flex:1;height:6px;background:#E5F4FA;border-radius:3px;overflow:hidden}
.progress .bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--cyan),var(--bleu));transition:width .3s}
.progress span{font-family:Arial,sans-serif;font-size:13px;color:var(--gris);white-space:nowrap;font-variant-numeric:tabular-nums}

/* cartes */
.card{background:#fff;border:1px solid var(--bord);border-radius:16px;padding:28px;margin-bottom:20px;box-shadow:0 8px 24px rgba(0,110,160,.07)}
.head{display:grid;grid-template-columns:56px 1fr auto;column-gap:18px;align-items:center;margin-bottom:22px}
.pastille{width:56px;height:56px;border-radius:50%;background:var(--bleu);display:flex;align-items:center;justify-content:center;box-shadow:0 6px 12px rgba(0,149,208,.28)}
.pastille svg{width:28px;height:28px}
.head h2{font-family:Arial,sans-serif;font-size:22px;line-height:1.2;margin:0;color:var(--noir)}
.head p{margin:4px 0 0;color:var(--gris);font-size:16px}
.num{font-family:Arial,sans-serif;font-size:34px;font-weight:700;color:var(--bleu);line-height:1}

/* identité */
.ident{display:grid;grid-template-columns:1fr 1fr;gap:16px}
label.f{display:block;font-family:Arial,sans-serif;font-size:13px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--gris);margin-bottom:7px}
input[type=text]{width:100%;height:50px;padding:0 16px;font-size:18px;border:1.5px solid var(--bord);border-radius:var(--r);font-family:inherit;background:#fff;color:#111;-webkit-appearance:none}
input[type=text]:focus{outline:none;border-color:var(--bleu);box-shadow:0 0 0 3px rgba(37,204,246,.2)}
.consigne{display:grid;grid-template-columns:22px 1fr;gap:12px;margin:18px 0 0;padding:14px 16px;background:var(--fond);border-radius:var(--r);font-size:16px;color:#333}

/* questions */
.q{padding:22px 0;border-top:1px solid #EAF5FA}
.q:first-child{padding-top:4px;border-top:none}
.qh{display:grid;grid-template-columns:30px 1fr;gap:12px;align-items:start;margin-bottom:14px}
.qn{width:30px;height:30px;border-radius:50%;background:var(--fond);color:var(--bleu);font-family:Arial,sans-serif;font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center;transition:.2s}
.q.ok .qn{background:var(--bleu);color:#fff}
.qt{font-size:18px;line-height:1.35;padding-top:3px;color:#111}
.qt b{font-family:Arial,sans-serif;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--gris);display:block;margin-bottom:2px}
.body{padding-left:42px}

button.opt{font:inherit;color:inherit;margin:0;cursor:pointer;-webkit-appearance:none;appearance:none}
.pair{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.choice{display:grid;grid-template-columns:34px 1fr;gap:12px;align-items:center;text-align:left;background:#fff;border:1.5px solid var(--bord);border-radius:var(--r);padding:14px 16px;min-height:76px;font-size:16px;line-height:1.35;transition:border-color .15s,background .15s}
.choice .l{width:34px;height:34px;border-radius:50%;border:1.5px solid var(--bord);display:flex;align-items:center;justify-content:center;font-family:Arial,sans-serif;font-weight:700;font-size:15px;color:var(--bleu);background:#fff}
.choice.on{background:var(--bleu);border-color:var(--bleu);color:#fff}
.choice.on .l{border-color:#fff;color:var(--bleu)}
.seg{display:grid;gap:10px;margin-top:10px}
.seg.s2{grid-template-columns:1fr 1fr}
.seg.s3{grid-template-columns:1fr 1fr 1fr;margin-top:0}
.seg.s3.sx{margin-top:10px}
.pill{height:46px;border-radius:var(--r);border:1.5px solid var(--bord);background:#fff;font-family:Arial,sans-serif !important;font-size:15px !important;font-weight:700;color:var(--noir) !important;display:flex;align-items:center;justify-content:center;padding:0 10px;transition:.15s}
.pill.mute{font-weight:400;color:var(--gris) !important;font-size:14px !important}
.pill.on{background:var(--bleu);border-color:var(--bleu);color:#fff !important}
.pill.mute.on{background:#5c6670;border-color:#5c6670}
@media(hover:hover){.choice:hover,.pill:hover{border-color:var(--cyan)}.choice.on:hover,.pill.on:hover{border-color:var(--bleu)}}

/* résultats */
.result{display:grid;grid-template-columns:1.35fr 1fr;gap:28px;align-items:start}
#matrix svg{display:block;width:100%;height:auto}
.legend{display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;font-size:14px;color:var(--gris);margin-top:12px;font-family:Arial,sans-serif}
.legend span{display:flex;align-items:center;gap:8px}
.kick2{font-family:Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--gris);margin:0 0 6px}
.big{font-family:Arial,sans-serif;font-size:26px;line-height:1.15;font-weight:700;color:var(--bleu);margin:0 0 8px}
.reading p.txt{margin:0 0 20px;font-size:17px;line-height:1.45}
.scores{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.sc{border:1px solid var(--bord);border-radius:var(--r);padding:12px 6px;text-align:center;background:var(--fond)}
.sc b{display:block;font-family:Arial,sans-serif;font-size:24px;color:var(--bleu);font-variant-numeric:tabular-nums}
.sc small{display:block;color:var(--gris);font-size:13px;line-height:1.25;margin-top:2px}
.nsp{margin-top:24px;padding:18px 20px;background:var(--fond);border-radius:var(--r)}
.nsp h3{margin:0 0 10px;font-family:Arial,sans-serif;font-size:16px;color:var(--noir)}
.nsp ul{margin:0;padding:0;list-style:none}
.nsp li{position:relative;padding-left:20px;margin:7px 0;font-size:16px;line-height:1.4}
.nsp li:before{content:"";position:absolute;left:2px;top:8px;width:8px;height:8px;border-radius:50%;background:var(--cyan)}
.actions{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:26px}
.btn{font-family:Arial,sans-serif;border:none;border-radius:30px;height:52px;padding:0 26px;font-size:16px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:10px;-webkit-appearance:none}
.btn.p{background:var(--bleu);color:#fff;box-shadow:0 6px 14px rgba(0,149,208,.3)}
.btn.s{background:#fff;color:var(--bleu);border:2px solid var(--bleu)}
.btn.g{background:none;color:var(--gris);font-weight:400;text-decoration:underline;padding:0 8px}
.meta{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:14px;font-size:14px;color:var(--gris)}
.meta a{color:var(--bleu)}
#msg{font-family:Arial,sans-serif}

footer{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:24px;margin-top:30px;padding-top:24px;border-top:1px solid var(--bord)}
footer img{height:42px;display:block}
footer .copy{font-family:Arial,sans-serif;font-size:11px;font-weight:700;color:#444;text-align:center;line-height:1.45}

@media(max-width:700px){
 .wrap{padding:0 14px 28px}
 .hero{padding:30px 14px 72px}.hero .in{padding:0 6px}
 .hero h1{font-size:28px}.hero p{font-size:17px}
 .progress .in{padding:10px 16px}
 .card{padding:20px 16px;border-radius:14px}
 .head{grid-template-columns:44px 1fr auto;column-gap:14px;margin-bottom:18px}
 .pastille{width:44px;height:44px}.pastille svg{width:22px;height:22px}
 .head h2{font-size:19px}.head p{font-size:15px}
 .num{font-size:22px;align-self:start;padding-top:4px}
 .ident{grid-template-columns:1fr;gap:14px}
 .qh{grid-template-columns:28px 1fr;gap:10px}.qn{width:28px;height:28px;font-size:13px}
 .qt{font-size:17px;padding-top:2px}
 .body{padding-left:0}
 .pair{grid-template-columns:1fr;gap:10px}
 .choice{min-height:0;font-size:16px;padding:13px 14px}
 .pill{height:46px;padding:0 6px;white-space:nowrap}
 .seg.s3{grid-template-columns:.8fr .8fr 1.5fr}
 .result{grid-template-columns:1fr;gap:22px}
 .big{font-size:23px}
 .actions{flex-direction:column;align-items:stretch}
 .btn.g{height:40px}
 footer{grid-template-columns:1fr;justify-items:center;text-align:center;gap:14px}
 footer .sp{display:none}
}
</style>
</head>
<body>
<div class="progress"><div class="in"><div class="bar"><i id="pbar"></i></div><span id="ptxt">0 / 0</span></div></div>
<header class="hero"><div class="in">
  <p class="kick">Formation économique · Stratégies de développement</p>
  <h1>Ma stratégie d'entreprise en un schéma</h1>
  <p>24 questions, 8 par dimension. Le point part du centre de la matrice et se déplace à chaque réponse.</p>
</div></header>

<div class="wrap lift">
  <section class="card">
    <div class="head">
      <div class="pastille"><svg viewBox="0 0 34 34"><circle cx="17" cy="11" r="7" fill="#fff"/><path d="M4 32c0-8 6-12 13-12s13 4 13 12z" fill="#fff"/></svg></div>
      <div><h2>Qui répond&nbsp;?</h2><p>Ces informations figurent sur le schéma exporté</p></div>
      <div class="num">00</div>
    </div>
    <div class="ident">
      <div><label class="f" for="prenom">Prénom</label><input type="text" id="prenom" autocomplete="given-name" placeholder="Camille"></div>
      <div><label class="f" for="entreprise">Entreprise</label><input type="text" id="entreprise" autocomplete="organization" placeholder="Transports Martin"></div>
    </div>
    <div class="consigne">
      <svg width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="#0095D0"/><rect x="9.8" y="9" width="2.4" height="7.5" rx="1" fill="#fff"/><circle cx="11" cy="6" r="1.5" fill="#fff"/></svg>
      <div>Répondez pour l'<b>entreprise</b> (l'entité qui a un CSE ou un CSE central), ni pour l'établissement, ni pour le groupe. Si le groupe a plusieurs métiers, répondez pour celui dont vous dépendez.</div>
    </div>
  </section>

  <section class="card">
    <div class="head">
      <div class="pastille"><svg viewBox="0 0 38 34"><rect x="17.7" y="3" width="2.6" height="24" fill="#fff"/><rect x="9" y="29" width="20" height="3" rx="1.5" fill="#fff"/><rect x="4" y="7" width="30" height="2.6" fill="#fff"/><path d="M2 20l5.5-10 5.5 10z" fill="#fff"/><path d="M25 20l5.5-10 5.5 10z" fill="#fff"/></svg></div>
      <div><h2>Coûts ou différenciation&nbsp;?</h2><p>La phrase la plus juste, ou «&nbsp;Les deux&nbsp;» si c'est vraiment le cas</p></div>
      <div class="num">01</div>
    </div>
    <div id="qX"></div>
  </section>

  <section class="card">
    <div class="head">
      <div class="pastille"><svg viewBox="0 0 38 22"><circle cx="10" cy="11" r="7.5" fill="none" stroke="#fff" stroke-width="4"/><rect x="17" y="9" width="19" height="4.4" fill="#fff"/><rect x="27" y="12" width="3.6" height="7" fill="#fff"/><rect x="32.4" y="12" width="3.6" height="5" fill="#fff"/></svg></div>
      <div><h2>Améliorer l'existant ou explorer&nbsp;?</h2><p>La phrase la plus juste, ou «&nbsp;Les deux&nbsp;» si c'est vraiment le cas</p></div>
      <div class="num">02</div>
    </div>
    <div id="qY"></div>
  </section>

  <section class="card">
    <div class="head">
      <div class="pastille"><svg viewBox="0 0 36 30"><rect x="2" y="2" width="19" height="15" rx="4" fill="#fff"/><rect x="14" y="12" width="20" height="16" rx="4" fill="#fff" stroke="#0095D0" stroke-width="2.4"/></svg></div>
      <div><h2>Seule ou avec d'autres&nbsp;?</h2><p>La coopération donne la forme du point sur la matrice</p></div>
      <div class="num">03</div>
    </div>
    <div id="qC"></div>
  </section>

  <section class="card" id="res">
    <div class="head">
      <div class="pastille"><svg viewBox="0 0 34 34"><rect x="3" y="3" width="3" height="28" fill="#fff"/><rect x="3" y="28" width="28" height="3" fill="#fff"/><circle cx="23" cy="11" r="5" fill="#fff"/><circle cx="13" cy="20" r="3" fill="#fff" opacity=".6"/></svg></div>
      <div><h2>Votre positionnement</h2><p id="status">Répondez aux questions pour placer votre entreprise</p></div>
      <div class="num">04</div>
    </div>
    <div class="result">
      <div>
        <div id="matrix"></div>
        <div class="legend">
          <span><svg width="18" height="18"><circle cx="9" cy="9" r="7" fill="#fff" stroke="#0095D0" stroke-width="2.5"/></svg>Plutôt seule</span>
          <span><svg width="18" height="18"><circle cx="9" cy="9" r="7" fill="#fff" stroke="#0095D0" stroke-width="2.5"/><path d="M9 2a7 7 0 0 0 0 14z" fill="#0095D0"/></svg>Mixte</span>
          <span><svg width="18" height="18"><circle cx="9" cy="9" r="7" fill="#0095D0" stroke="#0095D0" stroke-width="2.5"/></svg>Plutôt avec d'autres</span>
          <span><svg width="18" height="18"><circle cx="9" cy="9" r="4.5" fill="#0095D0"/><circle cx="9" cy="9" r="7.8" fill="none" stroke="#0095D0" stroke-width="1.5" stroke-dasharray="2.5 2"/></svg>Position peu fiable</span>
        </div>
      </div>
      <div class="reading">
        <p class="kick2">Positionnement</p>
        <p class="big" id="quad">À compléter</p>
        <p class="txt" id="quadTxt">Le résultat s'affiche au fil de vos réponses.</p>
        <p class="kick2">Conséquences probables sur l'emploi</p>
        <p class="txt" id="emploi">—</p>
        <div class="scores">
          <div class="sc"><b id="sX">0</b><small>Coûts ↔ Différenciation</small></div>
          <div class="sc"><b id="sY">0</b><small>Exploitation ↔ Exploration</small></div>
          <div class="sc"><b id="sC">0</b><small>Seule ↔ Avec d'autres</small></div>
        </div>
      </div>
    </div>
    <div class="nsp" id="nspBox" hidden>
      <h3>Vos « je ne sais pas » : questions à poser à la direction</h3>
      <ul id="nspList"></ul>
    </div>
    <div class="actions">
      <button type="button" class="btn p" id="send"><svg width="20" height="16" viewBox="0 0 20 16"><rect x="1.2" y="1.2" width="17.6" height="13.6" rx="2" fill="none" stroke="#fff" stroke-width="2.2"/><path d="M2 2.5l8 6.5 8-6.5" fill="none" stroke="#fff" stroke-width="2.2"/></svg>Envoyer mon PDF à Hiiato</button>
      <button class="btn s" id="exp"><svg width="18" height="18" viewBox="0 0 18 18"><rect x="7.8" y="1" width="2.4" height="10" fill="#0095D0"/><path d="M3.3 7.3L9 13l5.7-5.7z" fill="#0095D0"/><rect x="2" y="15" width="14" height="2.4" rx="1" fill="#0095D0"/></svg>Télécharger le PDF</button>
      
      <button class="btn g" id="reset">Recommencer</button>
      <button class="btn g" id="csv">Format tableur</button>
    </div>
    <p style="margin:14px 0 0;font-size:14px;color:#666">« Envoyer » ouvre le menu de partage du téléphone avec le PDF déjà joint : choisissez votre messagerie, puis l'adresse <b>contact@hiiato.fr</b>. Le PDF contient le schéma et toutes vos réponses. Elles restent sur votre appareil tant que vous ne l'envoyez pas.</p>
    <div class="meta"><span id="msg"></span><span>Adresse : <a href="mailto:contact@hiiato.fr">contact@hiiato.fr</a></span></div>
  </section>

  <footer>
    <img src="data:image/png;base64," alt="Hiato">
    <div class="copy">@HIIATO – Toute copie (Totale ou partielle) interdite – Utilisation commerciale interdite si non expressément acceptée dans le cadre d'une convention spécifique rédigée par HIIATO</div>
    <div class="sp" style="width:120px"></div>
  </footer>
</div>

<script>
const LOGO="data:image/png;base64,";
const NB=" ";
/* Chaque paire : [thème, pôle négatif (gauche / bas / seule), pôle positif (droite / haut / avec d'autres), question à poser si « je ne sais pas »]
   L'ordre d'affichage A/B est alterné (FLIP) pour qu'aucun côté ne soit toujours en A. */
const AX={
 x:{nom:"Coûts ou différenciation", neg:"Coûts", pos:"Différenciation", items:[
  ["Clients","Les clients nous choisissent surtout pour nos prix","Les clients nous choisissent surtout pour la qualité, le service ou le savoir-faire","Pourquoi les clients choisissent-ils l'entreprise plutôt qu'un concurrent ?"],
  ["Prix","Nos prix sont parmi les plus bas du marché","Nos prix sont plus élevés que la moyenne du marché, et les clients l'acceptent","Comment se situent nos prix par rapport à ceux des concurrents ?"],
  ["Effort principal","L'effort porte surtout sur la maîtrise des coûts, pour rester compétitif","L'effort porte surtout sur la qualité, pour se démarquer des concurrents","Où la direction porte-t-elle ses efforts : réduction des coûts ou qualité ?"],
  ["Offre","On propose des produits ou services standard, en volume","On propose des produits ou services spécifiques, adaptés ou sur mesure","Quelle part de l'activité est standard, quelle part est sur mesure ?"],
  ["Argument de vente","Pour convaincre ses clients, l'entreprise met surtout en avant ses prix ou ses promotions","Pour convaincre ses clients, l'entreprise met surtout en avant sa marque ou sa réputation","Qu'est-ce que l'entreprise met en avant pour convaincre ses clients ?"],
  ["Achats","Les fournisseurs sont choisis d'abord sur le prix","Les fournisseurs sont choisis d'abord sur la qualité","Sur quels critères les fournisseurs sont-ils choisis ?"],
  ["Salariés recherchés","On cherche surtout des salariés polyvalents, rapides à former","On cherche surtout des salariés spécialistes de leur métier, longs à former","Quels profils l'entreprise cherche-t-elle à recruter et à fidéliser ?"],
  ["Indicateurs suivis","Les chiffres les plus suivis sont les coûts, les volumes et la productivité","Les chiffres les plus suivis sont la satisfaction client, les réclamations et la qualité","Quels indicateurs la direction suit-elle en priorité ?"]]},
 y:{nom:"Exploitation ou exploration", neg:"Exploitation", pos:"Exploration", items:[
  ["Produits","L'entreprise améliore surtout ses produits ou services actuels","L'entreprise lance surtout des produits ou services nouveaux pour elle","Quelle part de l'activité vient de produits ou services lancés ces 3 dernières années ?"],
  ["Gamme","Elle cherche surtout à mieux organiser sa production ou son service actuel","Elle cherche surtout à élargir sa gamme de produits ou de services","Quels projets d'élargissement de gamme ou de réorganisation sont prévus ?"],
  ["Marchés","Elle cherche surtout à mieux servir ses clients actuels","Elle cherche surtout de nouveaux clients ou de nouveaux marchés (secteurs, territoires)","Quels nouveaux clients ou marchés l'entreprise vise-t-elle ?"],
  ["Technologies","Elle tire le meilleur parti des outils et méthodes qu'elle maîtrise déjà","Elle se lance dans des technologies ou des métiers nouveaux pour elle","Quelles technologies nouvelles sont en projet, et le CSE sera-t-il consulté ?"],
  ["Projets en cours","Les projets visent surtout à fiabiliser et améliorer ce qui existe","Les projets visent surtout à tester des choses nouvelles, quitte à ce qu'elles échouent","Quels projets sont en cours, et quel est leur objectif ?"],
  ["Formation","Les formations renforcent surtout les compétences actuelles","Les formations visent surtout des compétences nouvelles pour l'entreprise","Quelles compétences le plan de développement des compétences vise-t-il ?"],
  ["Investissements","Les investissements servent surtout à renouveler ou entretenir l'existant","Les investissements servent surtout à des activités, outils ou procédés nouveaux","À quoi ont servi les investissements des 3 dernières années ?"],
  ["Discours de la direction","La direction parle surtout de consolider et de fiabiliser l'existant","La direction parle surtout de transformation et de nouvelles activités","Quelles sont les priorités de la direction pour les 3 prochaines années ?"]]},
 c:{nom:"Seule ou avec d'autres", neg:"Seule", pos:"Avec d'autres", items:[
  ["Structure","L'entreprise est indépendante : ni groupe, ni réseau, ni franchise","L'entreprise fait partie d'un groupe, d'un réseau, d'une franchise ou d'un groupement","L'entreprise appartient-elle à un groupe ou à un réseau, et lequel ?"],
  ["Production","Elle réalise elle-même l'essentiel de son activité","Elle produit avec des partenaires durables (co-traitance, sous-traitance de long terme, production partagée)","Avec quels partenaires durables l'entreprise produit-elle ?"],
